# Copy to `.env` and fill in real values. `.env*` is gitignored — never commit
# the filled-in file.

# --- Convex (https://dashboard.convex.dev) ---------------------------------
# From `npx convex dev`, which writes these for you on first run.
CONVEX_DEPLOYMENT=
NEXT_PUBLIC_CONVEX_URL=
# Leave this blank locally. It is a *production* credential, and the Convex CLI
# picks it up from `.env` automatically — so a local `npx convex deploy` run to
# "try something" pushes to production rather than the dev deployment above,
# with no prompt. Set it only in the Vercel/CI environment that builds the app.
CONVEX_DEPLOY_KEY=

# --- Clerk auth (https://dashboard.clerk.com) ------------------------------
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# NOTE: your Clerk issuer domain is also hardcoded in `convex/auth.config.ts`.
# Update it there to match the Clerk instance these keys belong to.

# --- EdgeStore file uploads (https://edgestore.dev) ------------------------
EDGE_STORE_ACCESS_KEY=
EDGE_STORE_SECRET_KEY=

# --- Google Gemini, powers the AI chat (https://aistudio.google.com/apikey) -
GOOGLE_API_KEY=
# Optional. Defaults to gemini-2.0-flash-001. Set this to move to another model
# without a code change. Check the id against Google's current model list before
# setting it — a bad id is only caught by Google at request time, so it shows up
# as every chat returning a 404.
GEMINI_MODEL=
